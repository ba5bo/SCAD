// BarRod - 杆状设计
// 结构：长度91mm，横截面为半径5mm半圆（下方）+ 10mm宽5mm高矩形（上方）
// 平侧朝上，两端向上伸出8mm高、1.5mm宽耳朵，内部形成88mm缺口

$fn = 60; // 圆滑度

module BarRod() {
    // 主体杆：横截面半圆在下、矩形在上（平侧朝上），挤出91mm长度
    linear_extrude(height = 91) {
        // 半圆部分：半径5mm，圆心位于(5,5)，圆弧朝下
        translate([5, 5])
            circle(r = 5);
        // 矩形部分：10mm宽 x 5mm高，位于半圆上方，顶面为平侧
        translate([0, 5])
            square([10, 5]);
    }
    
    // 左耳：z=0端，从平顶面(y=10)向上伸出8mm高、1.5mm宽（沿Z轴）
    translate([0, 10, 0])
        cube([10, 8, 1.5]);
    
    // 右耳：z=91端，内侧距左耳88mm
    translate([0, 10, 91 - 1.5])
        cube([10, 8, 1.5]);
}

// 渲染模型
BarRod();
