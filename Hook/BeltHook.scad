$fn = 60;

// BeltHook：环形穿带扣
// 环：完整矩形环，内开口 50x10，壁厚 4.5，Z 宽 6.0
// C 形钩（开口朝下 ⊓）：横臂在顶（Z=6→8），竖臂（近端）和断臂+回钩（远端）都向下；
//   侧视（YZ 截面）：开口朝 -Z（向下），线厚 2，
//   竖臂高 8（Z=0→8，底部对齐环底面 Z=0，顶部突出环顶面 Z=6）；
//   远端断臂深 4（Z=2→6）+ 回钩深 4（Z=-2→2）+ 朝环回钩节深 4（Y=31→27，Z=-2→0），钩口宽 10；
//   竖臂外缘与环外边缘（Y=19）对齐；钩子沿环长边方向（X）总宽 46
union() {
    // 环
    linear_extrude(height = 6)
    difference() {
        square([59, 19]);
        translate([4.5, 4.5]) square([50, 10]);
    }

    // 钩子：截面在 YZ 平面，沿环长边方向（X）挤出 46，居中（偏移 (59-46)/2=6.5）
    translate([6.5, 19, 0])
    rotate([90, 0, 90])
    linear_extrude(height = 46)
    polygon([
        [0,8], [14,8], [14,-2], [8,-2], [8,0], [12,0], [12,6], [2,6],    // 横臂顶 + 外缘（Z=8→-2）+ 朝环回钩节（底Y=33→27，深4）+ 断臂内缘
        [2,0], [0,0]                                        // 竖臂内缘（高8，Z=6→0）+ 竖臂底（对齐环底面Z=0）
    ]);
}
